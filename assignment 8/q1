<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pseudo Classes Demo</title>

<style>
    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family: Arial, sans-serif;
    }

    body{
        padding:30px;
        background-color:#f4f4f4;
    }

    h1{
        text-align:center;
        margin-bottom:30px;
    }

    /* Flexbox Container */
    .container{
        display:flex;
        justify-content:space-around;
        align-items:flex-start;
        gap:20px;
        flex-wrap:wrap;
    }

    .box{
        background:white;
        padding:20px;
        border-radius:10px;
        width:220px;
        text-align:center;
        box-shadow:0 2px 8px rgba(0,0,0,0.2);
    }

    h3{
        margin-bottom:10px;
        color:#333;
    }

    p{
        font-size:14px;
        margin-bottom:15px;
        color:#555;
    }

    /* :hover */
    .hover-link{
        text-decoration:none;
        color:blue;
        font-weight:bold;
    }

    .hover-link:hover{
        color:white;
        background:blue;
        padding:5px 10px;
        border-radius:5px;
    }

    /* :focus */
    .focus-input{
        padding:8px;
        width:100%;
        border:2px solid gray;
        border-radius:5px;
    }

    .focus-input:focus{
        border-color:green;
        background-color:#e8ffe8;
        outline:none;
    }

    /* :active */
    .active-btn{
        padding:10px 15px;
        border:none;
        background:orange;
        color:white;
        border-radius:5px;
        cursor:pointer;
    }

    .active-btn:active{
        background:red;
        transform:scale(0.95);
    }

    /* :nth-child() */
    ul{
        list-style:none;
    }

    li{
        padding:8px;
        margin:4px 0;
        background:#ddd;
        border-radius:4px;
    }

    li:nth-child(odd){
        background:lightblue;
    }

    li:nth-child(even){
        background:lightgreen;
    }
</style>
</head>
<body>

<h1>Pseudo-Classes Demonstration</h1>

<div class="container">

    <!-- Hover Example -->
    <div class="box">
        <h3>:hover</h3>
        <p>Changes style when mouse pointer is placed over the element.</p>
        <a href="#" class="hover-link">Hover Over Me</a>
    </div>

    <!-- Focus Example -->
    <div class="box">
        <h3>:focus</h3>
        <p>Applies style when an input field receives focus.</p>
        <input type="text" class="focus-input" placeholder="Click here">
    </div>

    <!-- Active Example -->
    <div class="box">
        <h3>:active</h3>
        <p>Applies style while a button is being clicked.</p>
        <button class="active-btn">Click Me</button>
    </div>

    <!-- nth-child Example -->
    <div class="box">
        <h3>:nth-child()</h3>
        <p>Styles elements based on their position in a list.</p>
        <ul>
            <li>Item 1</li>
            <li>Item 2</li>
            <li>Item 3</li>
            <li>Item 4</li>
        </ul>
    </div>

</div>

</body>
</html>
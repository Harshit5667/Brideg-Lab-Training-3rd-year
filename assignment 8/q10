<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Combined Effects Demonstration</title>

<style>
    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family:Arial, sans-serif;
    }

    body{
        min-height:100vh;
        background:#f4f4f4;
        padding:40px;

        display:flex;
        justify-content:center;
        align-items:center;
    }

    h1{
        text-align:center;
        margin-bottom:30px;
        color:#333;
    }

    .container{
        width:100%;
        max-width:1200px;
    }

    /* Flexbox Layout */
    .effects-row{
        display:flex;
        justify-content:space-evenly;
        align-items:center;
        gap:25px;
        flex-wrap:wrap;
    }

    .card{
        background:white;
        padding:25px;
        border-radius:12px;
        text-align:center;
        width:250px;
        box-shadow:0 4px 10px rgba(0,0,0,0.1);
    }

    .card h3{
        margin-bottom:15px;
        color:#333;
    }

    /* Common Interactive Style */
    .effect{
        display:inline-block;
        padding:12px 24px;
        border:none;
        border-radius:8px;
        cursor:pointer;
        font-weight:bold;
        color:white;

        transition:
            transform 0.3s ease,
            background-color 0.3s ease,
            box-shadow 0.3s ease;
    }

    /* Example 1 */
    .btn-blue{
        background:#3498db;
    }

    .btn-blue:hover{
        background:#217dbb;
        transform:scale(1.08);
        box-shadow:0 8px 16px rgba(0,0,0,0.25);
    }

    .btn-blue:active{
        transform:scale(0.95);
    }

    /* Example 2 */
    .btn-green{
        background:#2ecc71;
    }

    .btn-green:hover{
        background:#27ae60;
        transform:translateY(-5px);
        box-shadow:0 8px 16px rgba(0,0,0,0.25);
    }

    .btn-green:active{
        transform:translateY(2px);
    }

    /* Example 3 */
    .btn-orange{
        background:#f39c12;
    }

    .btn-orange:hover{
        background:#d68910;
        transform:rotate(-3deg) scale(1.05);
        box-shadow:0 8px 16px rgba(0,0,0,0.25);
    }

    .btn-orange:active{
        transform:scale(0.95);
    }

    /* Focus Effect */
    .effect:focus{
        outline:none;
        box-shadow:0 0 0 4px rgba(52,152,219,0.35);
    }
</style>
</head>
<body>

<div class="container">

    <h1>Combined Effects Demonstration</h1>

    <div class="effects-row">

        <div class="card">
            <h3>Scale + Color Change</h3>
            <button class="effect btn-blue">
                Hover Me
            </button>
        </div>

        <div class="card">
            <h3>Lift + Shadow</h3>
            <button class="effect btn-green">
                Hover Me
            </button>
        </div>

        <div class="card">
            <h3>Rotate + Scale</h3>
            <button class="effect btn-orange">
                Hover Me
            </button>
        </div>

    </div>

</div>

</body>
</html>
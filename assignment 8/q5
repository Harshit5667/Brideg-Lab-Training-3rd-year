<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Styled Button Collection</title>

<style>
    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family: Arial, sans-serif;
    }

    body{
        min-height:100vh;
        background:#f4f4f4;
        display:flex;
        justify-content:center;
        align-items:center;
        flex-direction:column;
        padding:20px;
    }

    h1{
        margin-bottom:30px;
        color:#333;
    }

    /* Flexbox Container */
    .button-container{
        display:flex;
        gap:20px;
        flex-wrap:wrap;
        justify-content:center;
        align-items:center;
    }

    /* Common Button Styles */
    .btn{
        padding:12px 24px;
        border:none;
        border-radius:10px;
        font-size:16px;
        font-weight:bold;
        cursor:pointer;
        transition:all 0.3s ease;
        box-shadow:0 4px 10px rgba(0,0,0,0.2);
    }

    /* Primary Button */
    .primary{
        background:#007bff;
        color:white;
    }

    /* Secondary Button */
    .secondary{
        background:#28a745;
        color:white;
    }

    /* Outline Button */
    .outline{
        background:transparent;
        color:#007bff;
        border:2px solid #007bff;
    }

    /* Hover Effects */
    .btn:hover:not(:disabled){
        transform:translateY(-3px);
        box-shadow:0 6px 14px rgba(0,0,0,0.25);
    }

    /* Active Effects */
    .btn:active:not(:disabled){
        transform:scale(0.96);
    }

    /* Focus Pseudo-Class */
    .btn:focus{
        outline:none;
        box-shadow:0 0 0 4px rgba(0,123,255,0.4);
    }

    /* Disabled Pseudo-Class */
    .btn:disabled{
        background:#bdbdbd;
        color:#666;
        cursor:not-allowed;
        opacity:0.7;
        box-shadow:none;
    }
</style>
</head>
<body>

<h1>Styled Button Collection</h1>

<div class="button-container">

    <button class="btn primary">
        Primary
    </button>

    <button class="btn secondary">
        Secondary
    </button>

    <button class="btn outline">
        Outline
    </button>

    <button class="btn" disabled>
        Disabled
    </button>

</div>

</body>
</html>